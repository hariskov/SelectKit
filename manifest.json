{
  "manifest_version": 3,
  "name": "SelectKit",
  "version": "0.0.1",
  "description": "Completes selections to whole words, sends text to Google Translate, converts prices and units.",
  "browser_specific_settings": {
    "gecko": {
      "id": "selectkit@xumepa",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "SelectKit",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
