{
  "manifest_version": 3,
  "name": "SelectKit",
  "version": "0.2.0",
  "description": "Completes selections to whole words, sends text to Google Translate, converts prices and units.",
  "browser_specific_settings": {
    "gecko": {
      "id": "selectkit@xumepa",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/popup.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "SelectKit",
    "default_icon": "icons/icon.svg",
    "default_area": "navbar"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
